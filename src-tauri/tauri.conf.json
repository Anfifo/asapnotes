{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "asapnotes",
  "version": "0.1.0",
  "identifier": "com.anfifo.asapnotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "asapnotes",
        "width": 1040,
        "height": 720,
        "center": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/asapnotes/assets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Anfifo",
    "copyright": "Copyright (c) 2026 Anfifo",
    "shortDescription": "Instant-capture markdown notes",
    "longDescription": "Always-resident tray app summoned by a global hotkey. Notes are plain markdown files you own.",
    "licenseFile": "../LICENSE",
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
